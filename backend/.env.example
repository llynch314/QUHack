# Copy this file to .env (make env does it for you) and fill in your own values.
# Never commit .env - it holds secrets.

# --- Claude (required: text chat and webcam expression check) ---
# Get a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=your_key_here
# Optional overrides (these are the defaults)
# CLAUDE_CHAT_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low

# --- Gemini (optional: voice mode only, which uses Gemini Live) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# --- Text-message alerts (optional) ---
# Family members can get alerts by SMS. Without these, texts are printed in the
# terminal instead (demo mode). Get them at https://console.twilio.com
# Trial accounts can only text numbers you've verified in the Twilio console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Spotify (optional: calm playlists for each mood on the dashboard) ---
# Create an app at https://developer.spotify.com/dashboard. Without these, the music card
# shows Spotify search links instead of playlists.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Flask sessions ---
# Any long random string. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# --- Sign in with Google (optional) ---
# Google Cloud Console > APIs & Services > Credentials > Create OAuth client ID (Web application)
# Authorized redirect URI: http://127.0.0.1:5000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Demo sign-in without Google, for local testing only. Set to 1 to enable.
# Gives one demo account per type: patient, health provider, family member.
DEV_LOGIN=0

# --- Database (optional) ---
# Defaults to SQLite at backend/instance/attunemind.db
# DATABASE_URL=postgresql://user:password@localhost:5432/attunemind

# --- wearable ---
# Encryption key for wearable data at rest (required unless DEMO_MODE=1). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WEARABLE_DATA_KEY=
# 1 = Demo Control Panel + simulator endpoints (and a dev encryption key if WEARABLE_DATA_KEY is empty)
DEMO_MODE=0
# free | paid | vertex_baa. On "free" (default), no wearable-derived data is ever sent to the AI (Claude).
AI_DATA_TIER=free
# allow_localhost (plain http only from this laptop) | strict (HTTPS always)
WEARABLE_REQUIRE_HTTPS=allow_localhost
# 1 when browsing through the HTTPS tunnel (secure cookies; http://127.0.0.1 sign-in then stops working)
WEARABLE_SECURE_COOKIES=0
# Public tunnel URL, e.g. https://attunemind.example.com (used for the ingest URL and push links)
PUBLIC_BASE_URL=
# Optional: buzz your phone + Apple Watch via the ntfy app. Pick a long random topic name.
NTFY_TOPIC=
# Idle sign-out on vitals pages, minutes (set 1 to test it quickly)
WEARABLE_IDLE_MINUTES=15
# Fall "I'm OK" countdown before family are alerted, seconds
WEARABLE_FALL_COUNTDOWN=60
# --- end wearable ---
