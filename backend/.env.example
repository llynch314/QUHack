# Copy this file to .env (make env does it for you) and fill in your own values.
# Never commit .env - it holds secrets.

# --- Claude (required: text chat and webcam expression check) ---
# Get a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=your_key_here
# Optional overrides (these are the defaults)
# CLAUDE_CHAT_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low

# --- Gemini (optional: voice mode only, which uses Gemini Live) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# --- Flask sessions ---
# Any long random string. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# --- Sign in with Google (optional) ---
# Google Cloud Console > APIs & Services > Credentials > Create OAuth client ID (Web application)
# Authorized redirect URI: http://127.0.0.1:5000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Demo sign-in without Google, for local testing only. Set to 1 to enable.
# Gives one demo account per type: patient, health provider, family member.
DEV_LOGIN=0

# --- Database (optional) ---
# Defaults to SQLite at backend/instance/attunemind.db
# DATABASE_URL=postgresql://user:password@localhost:5432/attunemind
