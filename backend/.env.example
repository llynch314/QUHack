# Copy this file to .env (make env does it for you) and fill in your own values.
# Never commit .env - it holds secrets.

# --- Gemini (required) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here
# Optional model overrides (these are the defaults)
# GEMINI_CHAT_MODEL=gemini-3.8-flash
# GEMINI_LIVE_MODEL=gemini-3.8-live
# GEMINI_LIVE_THINKING_MODEL=gemini-3.8-live-extended-thinking
# GEMINI_THINKING_LEVEL=low

# --- Flask sessions ---
# Any long random string. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# --- Sign in with Google (optional) ---
# Google Cloud Console > APIs & Services > Credentials > Create OAuth client ID (Web application)
# Authorized redirect URI: http://127.0.0.1:5000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Demo sign-in without Google, for local testing only. Set to 1 to enable.
DEV_LOGIN=0

# --- Database (optional) ---
# Defaults to SQLite at backend/instance/mindconnect.db
# DATABASE_URL=postgresql://user:password@localhost:5432/mindconnect
